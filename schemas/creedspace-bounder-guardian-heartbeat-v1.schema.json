{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.bounder.io/schemas/creedspace-bounder-guardian-heartbeat-v1.schema.json",
  "title": "Creed Space Bounder private Guardian heartbeat v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "visibility", "fleet_id", "guardian_id", "platform", "boot_id", "sequence",
    "generated_at", "expires_at", "state", "reason", "policy", "checkpoint",
    "continuity_lease_expires_at", "evidence", "decisions", "audit", "resources"
  ],
  "properties": {
    "version": { "const": "creedspace-bounder-guardian-heartbeat/v1" },
    "visibility": { "const": "fleet-private" },
    "fleet_id": { "$ref": "#/$defs/identity" },
    "guardian_id": { "$ref": "#/$defs/identity" },
    "platform": { "enum": ["aerial", "ground", "marine", "warehouse", "inspection", "fixed_machinery"] },
    "boot_id": { "$ref": "#/$defs/bootId" },
    "sequence": { "$ref": "#/$defs/sequence" },
    "generated_at": { "$ref": "#/$defs/utcDateTime" },
    "expires_at": { "$ref": "#/$defs/utcDateTime" },
    "state": { "enum": ["healthy", "degraded", "held", "recovering"] },
    "reason": { "$ref": "#/$defs/reason" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "digest", "sequence", "expires_at", "verified"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/identity" },
        "digest": { "$ref": "#/$defs/sha256" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "expires_at": { "$ref": "#/$defs/utcDateTime" },
        "verified": { "type": "boolean" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "persisted_at", "rollback_detected"],
      "properties": {
        "sequence": { "$ref": "#/$defs/nonnegative" },
        "persisted_at": { "$ref": "#/$defs/utcDateTime" },
        "rollback_detected": { "type": "boolean" }
      }
    },
    "continuity_lease_expires_at": { "$ref": "#/$defs/utcDateTime" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshest_at", "required_max_age_ms"],
      "properties": {
        "freshest_at": { "$ref": "#/$defs/utcDateTime" },
        "required_max_age_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_ms", "evaluated", "allowed", "held", "failures", "latency_ms"],
      "properties": {
        "window_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "evaluated": { "$ref": "#/$defs/nonnegative" },
        "allowed": { "$ref": "#/$defs/nonnegative" },
        "held": { "$ref": "#/$defs/nonnegative" },
        "failures": { "$ref": "#/$defs/nonnegative" },
        "latency_ms": { "$ref": "#/$defs/latency" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queued", "oldest_queued_age_ms"],
      "properties": {
        "queued": { "$ref": "#/$defs/nonnegative" },
        "oldest_queued_age_ms": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_percent", "memory_percent", "network_tx_bytes", "network_rx_bytes"],
      "properties": {
        "cpu_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "network_tx_bytes": { "$ref": "#/$defs/nonnegative" },
        "network_rx_bytes": { "$ref": "#/$defs/nonnegative" }
      }
    }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S" },
    "bootId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "utcDateTime": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "format": "date-time",
      "pattern": "^(?!0000-)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reason": {
      "enum": [
        "none", "audit_backlog", "resource_pressure", "evidence_lag", "partial_connectivity",
        "policy_expired", "policy_unverified", "continuity_lease_expired", "rollback_detected",
        "guardian_restart", "checkpoint_restore"
      ]
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max"],
      "properties": {
        "p50": { "$ref": "#/$defs/nonnegative" },
        "p95": { "$ref": "#/$defs/nonnegative" },
        "p99": { "$ref": "#/$defs/nonnegative" },
        "max": { "$ref": "#/$defs/nonnegative" }
      }
    }
  }
}
