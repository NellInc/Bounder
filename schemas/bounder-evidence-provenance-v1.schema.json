{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.bounder.io/schemas/bounder-evidence-provenance-v1.schema.json",
  "title": "Bounder evidence provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "producer_source",
    "generator",
    "toolchain",
    "inputs",
    "contracts",
    "outputs"
  ],
  "properties": {
    "version": {
      "const": "bounder-evidence-provenance/v1"
    },
    "producer_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "clean"],
      "properties": {
        "repository": {
          "const": "https://github.com/NellInc/Bounder-from-org"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "const": true
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "entrypoint"],
      "properties": {
        "id": {
          "const": "bounder-website-evidence-export"
        },
        "version": {
          "const": "1"
        },
        "entrypoint": {
          "const": "scripts/export-website-artifacts.py"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_module", "python"],
      "properties": {
        "go_module": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^go [1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "python": {
          "const": "python 3"
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/fileRecords"
    },
    "contracts": {
      "$ref": "#/$defs/fileRecords"
    },
    "outputs": {
      "$ref": "#/$defs/fileRecords"
    }
  },
  "$defs": {
    "fileRecords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 52428800
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
