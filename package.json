{
  "name": "bounder-website",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NellInc/Bounder.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "system:check": "node scripts/validate-system.mjs && node scripts/generate-system-views.mjs --check",
    "system:generate": "node scripts/generate-system-views.mjs",
    "inspect": "node scripts/system-inspect.mjs",
    "check:changed": "node scripts/check-changed.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "release:manifest:v2": "node scripts/generate-release-manifest-v2.mjs",
    "test": "node --test tests/*.test.js",
    "test:observability": "node --test tests/guardian-fleet-observability.test.js tests/observability-benchmark.test.js",
    "benchmark:observability": "node scripts/benchmark-observability.mjs",
    "verify:producer": "node scripts/verify-producer-derivation.mjs",
    "verify:changed": "node scripts/verify-changed.mjs",
    "check:live": "node scripts/check-live.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:browser": "playwright test",
    "quality": "npm run test:coverage && npm run test:browser && node_modules/.bin/impeccable detect .",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "impeccable": "3.2.1"
  }
}
