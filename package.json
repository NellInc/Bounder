{
  "name": "bounder-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --all --clean --temp-directory=/tmp/bounder-c8-unit --reporter=text --check-coverage --per-file --lines=85 --branches=75 --functions=85 --include='*.js' --include='scripts/**/*.{js,mjs}' --exclude='playwright.config.js' --exclude='simulator-bootstrap.js' --exclude='simulator-fallback.js' --exclude='simulator.js' --exclude='site.js' node --test tests/*.test.js",
    "test:browser": "playwright test",
    "quality": "npm run test:coverage && npm run test:browser && npx --yes impeccable@3.2.1 detect ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0"
  }
}
